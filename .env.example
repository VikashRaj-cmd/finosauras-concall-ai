# AI Provider — use ONE of these
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Which AI provider to use: "gemini" or "groq"
AI_PROVIDER=gemini

# Polling interval in seconds (how often to check NSE/BSE for new filings)
POLL_INTERVAL_SECONDS=300

# Companies to track (NSE symbols, comma-separated)
TRACKED_SYMBOLS=RELIANCE,HDFCBANK,TATAMOTORS,SUNPHARMA,INFY

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
